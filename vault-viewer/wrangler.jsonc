{
  // 隨身密閱：同一個 Worker 提供打包器網頁、手機檢視頁（./dist，需先 npm run build），
  // 並負責 /api/*：保管每份封存檔的伺服器金鑰分片，檢查次數／期限／收回，記錄開啟紀錄。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vault-viewer",
  "main": "server/src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // keep variables edited in the Cloudflare dashboard when redeploying
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /api/* always runs the Worker; everything else is a static file (free and unlimited).
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "observability": { "enabled": true }
}
