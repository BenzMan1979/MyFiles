{
  "name": "vault-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:viewer": "vite build --config vite.viewer.config.ts && node scripts/inline-viewer.mjs",
    "build:app": "vite build && node scripts/inline-app.mjs",
    "build": "tsc --noEmit && tsc -p server --noEmit && npm run build:viewer && npm run build:app",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && LANG=C.UTF-8 LC_ALL=C.UTF-8 E2E=1 vitest run",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "deploy:ci": "node scripts/deploy-ci.mjs"
  },
  "dependencies": {
    "docx-preview": "^0.4.1",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "jsqr": "^1.4.0",
    "marked": "^18.1.2",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.156.0"
  }
}
